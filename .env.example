SHOPIFY_API_KEY=replace_with_app_client_id
SHOPIFY_API_SECRET=replace_with_app_secret
SHOPIFY_SCOPES=read_products,read_orders
APP_URL=https://your-tunnel.trycloudflare.com

REDIS_URL=redis://localhost:6379
PORT=3000

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=shopify
PGSSL=false

# Smoke test (optional, dev only)
SMOKE_RUN=0
SMOKE_SHOP=your-dev-shop.myshopify.com
# SMOKE_SECRET defaults to SHOPIFY_API_SECRET if unset.
